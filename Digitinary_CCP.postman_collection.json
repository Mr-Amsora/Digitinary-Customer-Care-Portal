            "pm.test('Token returned', () => pm.expect(json.token).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }

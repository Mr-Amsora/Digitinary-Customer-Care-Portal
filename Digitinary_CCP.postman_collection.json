  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "pm.collectionVariables.set('adminToken', json.token);",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token returned', () => pm.expect(json.token).to.be.a('string'));",
            "pm.test('ExpiresIn is 3600', () => pm.expect(json.expiresIn).to.equal(3600));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "http://localhost:8080/api/auth/login", "host": ["http://localhost:8080"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login as Customer1",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "pm.collectionVariables.set('customerToken', json.token);",
